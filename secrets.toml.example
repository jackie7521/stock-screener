# ============================================================
# Streamlit Secrets 範例檔
# ============================================================
# 使用方式：
# 1. 在本機：複製這個檔案為 .streamlit/secrets.toml，填入你的真實金鑰
# 2. 在 Streamlit Cloud：到 App settings → Secrets，貼上下面內容並填入真實金鑰
#
# ⚠️ 重要：.streamlit/secrets.toml 已被 .gitignore 排除，絕對不會上傳到 GitHub
# ============================================================

# FinMind API Token（如果有付費版）
# 申請網址：https://finmindtrade.com/
FINMIND_TOKEN = "在這裡貼上你的 FinMind token"

# 永豐 Shioaji API（如果之後要接下單）
SHIOAJI_API_KEY = "你的 API Key"
SHIOAJI_SECRET_KEY = "你的 Secret Key"
SHIOAJI_CA_PATH = "ca.pfx"
SHIOAJI_CA_PASSWORD = "憑證密碼"
SHIOAJI_PERSON_ID = "你的身分證字號"

# Line Notify Token（如果要做推播）
LINE_NOTIFY_TOKEN = "你的 Line Notify Token"
